---
layout: layouts/base.njk
title: Contact
permalink: /contact/index.html
eleventyExcludeFromCollections: true
---
{% if site.contact.enabled %}
<article class="gala-contact" data-contact-form data-site-id="{{ site.site.id | escape }}">
  <h1>Contact</h1>
  <p>Sign in with your Gala account to send a private message to the author.</p>
  <form>
    <label>Subject <input name="subject" maxlength="200" required></label>
    <label>Message <textarea name="message" maxlength="5000" required></textarea></label>
    {% if site.contact.websiteEnabled %}<label>Website (optional) <input name="website" type="url" maxlength="2048" autocomplete="url"></label>{% endif %}
    {% if site.contact.phoneEnabled %}<label>Phone (optional) <input name="phone" type="tel" maxlength="32" autocomplete="tel"></label>{% endif %}
    <button type="submit">Send message</button>
  </form>
  <p data-contact-status role="status" aria-live="polite"></p>
</article>
{% else %}
<h1>Contact</h1><p>This site is not accepting contact messages.</p>
{% endif %}
